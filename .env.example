# Copy this file to `.env` and adjust the values if you need to.
#
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows Command Prompt)
#
# `.env` is gitignored and never travels with the code. Guest booking works
# without it; staff login requires local password hashes configured below.

# MySQL settings — only used once the database layer replaces data/*.json.
DB_HOST=localhost
DB_NAME=reservibe
DB_USER=root
DB_PASS=

# Hold countdowns and timestamps are shown in resort-local time.
APP_TIMEZONE=Asia/Manila

# Local demonstration accounts. Store password hashes only; see README for setup.
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD_HASH=
DEMO_STAFF_USER=staff
DEMO_STAFF_PASSWORD_HASH=

# Optional Module 8: Google Calendar API OAuth 2.0 web application credentials.
# Create OAuth credentials in Google Cloud, enable Calendar API, and authorize
# the exact redirect URI below. The app will not sync until these are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/?action=google-callback
GOOGLE_CALENDAR_ID=primary
